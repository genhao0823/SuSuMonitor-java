      "AiAlertExplanation": {
        "type": "object",
        "required": [
          "record_id",
          "summary",
          "provider",
          "model",
          "prompt_version"
        ],
        "properties": {
          "record_id": {
            "type": "integer",
            "format": "int64",
            "description": "Alert record ID the explanation belongs to."
          },
          "summary": {
            "type": "string",
            "maxLength": 4000,
            "description": "One-paragraph human-readable analysis of the alert."
          },
          "possible_causes": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            },
            "description": "Possible root causes (analysis only, never executable steps)."
          },
          "impact": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            },
            "description": "Expected impact assessment."
          },
          "suggestions": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            },
            "description": "Procedural human-review guidance; never executable steps or commands."
          },
          "limitations": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            },
            "description": "Explicit boundaries of this explanation (anti-fabrication statement)."
          },
          "usage": {
            "type": "object",
            "nullable": true,
            "description": "Token usage of the underlying model call (input_tokens/output_tokens/total_tokens).",
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          },
          "provider": {
            "type": "string",
            "description": "Provider identifier, e.g. openai-compatible."
          },
          "model": {
            "type": "string",
            "description": "Model name used for the explanation."
          },
          "prompt_version": {
            "type": "string",
            "description": "Server-side explanation prompt version, e.g. ai-alert-explanation-v1."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Explanation generation timestamp (UTC ISO-8601)."
          }
        }
      },
      "AiAlertExplanationResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/AiAlertExplanation"
          }
        }
      }
    }
