{
  "openapi": "3.0.3",
  "info": {
    "title": "SuSuMonitor Alert API",
    "description": "Authoritative SuSuMonitor alert API contract covering alert rule CRUD, alert record queries, mark-as-read, notification history, and the AI alert explanation review endpoint. Rule creation, update, and deletion require ROLE_ADMIN. Rule listing, record queries, mark-as-read, and notification history require authenticated users. The AI explanation endpoint requires ROLE_ADMIN and is only mounted when susumonitor.ai.explanation.enabled=true (404 otherwise). Alert evaluation is event-driven via MetricsReportedEvent AFTER_COMMIT, not exposed as REST endpoints.",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "http://localhost:18080",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "alert",
      "description": "Alert rules, records, and push"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/alerts/rules": {
      "post": {
        "tags": [
          "alert"
        ],
        "summary": "Create alert rule",
        "description": "Creates an alert rule. Admin-only. server_id null means a general rule matching all servers. metric must be cpu/memory/disk/temperature/load; the load rule evaluates the system load average exposed by metrics.load_avg. operator must be >/>=/</<=. level must be warning/critical.",
        "operationId": "createAlertRule",
        "parameters": [
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlertRuleRequest"
              },
              "examples": {
                "serverSpecific": {
                  "summary": "Server-specific CPU rule",
                  "value": {
                    "server_id": 1,
                    "metric": "cpu",
                    "operator": ">",
                    "threshold_value": 80,
                    "level": "warning"
                  }
                },
                "generalRule": {
                  "summary": "General memory rule (all servers)",
                  "value": {
                    "metric": "memory",
                    "operator": ">=",
                    "threshold_value": 90,
                    "level": "critical"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule created",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRuleResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "id": 1,
                    "server_id": 1,
                    "metric": "cpu",
                    "operator": ">",
                    "threshold_value": 80,
                    "level": "warning",
                    "enabled": true,
                    "created_by": 1,
                    "created_at": "2026-07-22T00:00:00Z",
                    "updated_at": "2026-07-22T00:00:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequestParameter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "tags": [
          "alert"
        ],
        "summary": "List alert rules",
        "description": "Returns all non-deleted alert rules, ordered by created_at DESC. Authenticated users only.",
        "operationId": "listAlertRules",
        "parameters": [
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Rule list",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRuleListResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": [
                    {
                      "id": 1,
                      "server_id": 1,
                      "metric": "cpu",
                      "operator": ">",
                      "threshold_value": 80,
                      "level": "warning",
                      "enabled": true,
                      "created_by": 1,
                      "created_at": "2026-07-22T00:00:00Z",
                      "updated_at": "2026-07-22T00:00:00Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/alerts/rules/{id}": {
      "put": {
        "tags": [
          "alert"
        ],
        "summary": "Update alert rule",
        "description": "Updates threshold_value, level, and enabled. Does not allow changing metric, operator, or server_id. Admin-only.",
        "operationId": "updateAlertRule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Rule ID, must be positive.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAlertRuleRequest"
              },
              "example": {
                "threshold_value": 90,
                "level": "critical",
                "enabled": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule updated",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRuleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequestParameter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "alert"
        ],
        "summary": "Delete alert rule (soft delete)",
        "description": "Soft-deletes the rule by setting deleted=1. Admin-only.",
        "operationId": "deleteAlertRule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Rule ID, must be positive.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Rule deleted",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": null
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/alerts/records": {
      "get": {
        "tags": [
          "alert"
        ],
        "summary": "List alert records (paginated)",
        "description": "Returns paginated alert records, optionally filtered by server_id and status (unread/read/resolved). Authenticated users only.",
        "operationId": "listAlertRecords",
        "parameters": [
          {
            "name": "server_id",
            "in": "query",
            "required": false,
            "description": "Filter by server ID.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by status: unread, read, resolved.",
            "schema": {
              "type": "string",
              "enum": [
                "unread",
                "read",
                "resolved"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated alert records",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRecordPageResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "items": [
                      {
                        "id": 1,
                        "rule_id": 1,
                        "server_id": 1,
                        "metric": "cpu",
                        "current_value": 90.5,
                        "threshold_value": 80,
                        "level": "warning",
                        "status": "unread",
                        "triggered_at": "2026-07-22T00:00:00Z",
                        "created_at": "2026-07-22T00:00:00Z"
                      }
                    ],
                    "total": 1,
                    "page": 1,
                    "page_size": 20
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequestParameter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/alerts/records/{id}/read": {
      "put": {
        "tags": [
          "alert"
        ],
        "summary": "Mark alert record as read",
        "description": "Marks an unread alert record as read. Already read or resolved records are not affected. Authenticated users only.",
        "operationId": "markAlertRecordAsRead",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Record ID, must be positive.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Record marked as read",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": null
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/alerts/records/{id}/notifications": {
      "get": {
        "tags": [
          "alert"
        ],
        "summary": "List alert record notification history",
        "description": "Returns per-channel delivery attempts (status/attempts/last_error) for an alert record. Authenticated users only.",
        "operationId": "listAlertRecordNotifications",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Record ID, must be positive.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification history returned",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertNotificationListResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": [
                    {
                      "id": 1,
                      "alert_record_id": 42,
                      "channel": "email",
                      "status": "sent",
                      "attempts": 1,
                      "next_attempt_at": null,
                      "last_error": null,
                      "created_at": "2026-08-07T10:00:00Z",
                      "updated_at": "2026-08-07T10:00:01Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/alerts/records/{id}/explanation": {
      "get": {
        "tags": [
          "alert"
        ],
        "summary": "Get the AI explanation of an alert record",
        "description": "Returns the stored AI-generated explanation (summary/possible causes/impact/suggestions/limitations) for an alert record. Admin-only. Only available when susumonitor.ai.explanation.enabled=true; the endpoint returns 404 when disabled or when the record has no AI explanation. Suggestions are human-review guidance, never executable steps.",
        "operationId": "getAlertExplanation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Alert record ID, must be positive.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Explanation returned",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiAlertExplanationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "XRequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Client-provided value is ignored; the server generates a UUID request ID for every response.",
        "schema": {
          "type": "string"
        }
      },
      "XCorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "description": "Optional client correlation ID. Invalid values are ignored and never logged.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "UUID request ID generated by the server.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "XCorrelationId": {
        "description": "Validated client correlation ID, returned only when a valid request header was provided.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid, or expired JWT (40100)",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestId"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/XCorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 40100,
              "message": "unauthorized",
              "data": null
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not an administrator (40300)",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestId"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/XCorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 40300,
              "message": "forbidden",
              "data": null
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found (40400)",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestId"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/XCorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 40400,
              "message": "resource not found",
              "data": null
            }
          }
        }
      },
      "InvalidRequestParameter": {
        "description": "Invalid request parameter (40002)",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestId"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/XCorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 40002,
              "message": "invalid request parameter",
              "data": null
            }
          }
        }
      }
    },
    "schemas": {
      "CreateAlertRuleRequest": {
        "type": "object",
        "required": [
          "metric",
          "operator",
          "threshold_value",
          "level"
        ],
        "properties": {
          "server_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Server ID. Null means general rule."
          },
          "metric": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "disk",
              "temperature",
              "load"
            ],
            "description": "Alert metric name. load maps to the system load average value exposed as metrics.load_avg."
          },
          "operator": {
            "type": "string",
            "enum": [
              ">",
              ">=",
              "<",
              "<="
            ]
          },
          "threshold_value": {
            "type": "number",
            "minimum": 0
          },
          "level": {
            "type": "string",
            "enum": [
              "warning",
              "critical"
            ]
          },
          "confirm_count": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "连续越界确认次数(可选,默认1=立即触发)"
          },
          "notify_email": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "通知邮件地址，多个用英文逗号分隔（可选）"
          },
          "notify_dingtalk": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "钉钉机器人 Webhook URL（可选）"
          },
          "notify_webhook": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "自定义 Webhook URL，POST JSON（可选）"
          }
        }
      },
      "UpdateAlertRuleRequest": {
        "type": "object",
        "required": [
          "threshold_value",
          "level",
          "enabled"
        ],
        "properties": {
          "threshold_value": {
            "type": "number",
            "minimum": 0
          },
          "level": {
            "type": "string",
            "enum": [
              "warning",
              "critical"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "confirm_count": {
            "type": "integer",
            "minimum": 1,
            "description": "连续越界确认次数(可选项,不传保持原值)"
          },
          "notify_email": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "通知邮件地址（传入则更新，不传保持原值）"
          },
          "notify_dingtalk": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "钉钉机器人 Webhook URL（传入则更新，不传保持原值）"
          },
          "notify_webhook": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "自定义 Webhook URL（传入则更新，不传保持原值）"
          }
        }
      },
      "AlertRule": {
        "type": "object",
        "required": [
          "id",
          "metric",
          "operator",
          "threshold_value",
          "level",
          "enabled",
          "confirm_count"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "server_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "metric": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "threshold_value": {
            "type": "number"
          },
          "level": {
            "type": "string"
          },
          "confirm_count": {
            "type": "integer",
            "minimum": 1,
            "description": "连续越界确认次数: 1=立即触发, >1=连续N次越界触发"
          },
          "notify_email": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "通知邮件地址，多个用英文逗号分隔"
          },
          "notify_dingtalk": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "钉钉机器人 Webhook URL"
          },
          "notify_webhook": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "自定义 Webhook URL，POST JSON"
          },
          "enabled": {
            "type": "boolean"
          },
          "created_by": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AlertRecord": {
        "type": "object",
        "required": [
          "id",
          "server_id",
          "metric",
          "current_value",
          "threshold_value",
          "level",
          "status",
          "triggered_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "rule_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "server_id": {
            "type": "integer",
            "format": "int64"
          },
          "metric": {
            "type": "string"
          },
          "current_value": {
            "type": "number"
          },
          "threshold_value": {
            "type": "number"
          },
          "level": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "unread",
              "read",
              "resolved"
            ]
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "read_by": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "read_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "triggered_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Recovery timestamp. Present only when status=resolved; null while unresolved. Stored as alert_records.resolved_at and serialized as UTC ISO-8601."
          },
          "notified_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "外部通知发送完成时间；null=未成功发送"
          },
          "notify_channels": {
            "type": "string",
            "nullable": true,
            "description": "成功送达的渠道，逗号分隔(email/dingtalk/webhook)；null=未成功发送"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
