# SuSuMonitor Docker Compose 环境变量模板。
# 用法：cp .env.example .env 后填写；或保留在非仓库路径并用
#   docker compose --env-file <path> up -d
# .env / .env.* 已被 .gitignore 排除，严禁提交任何真实值。
# 密钥生成（在 Linux/WSL/Git Bash 执行）：
#   JWT_SECRET  : openssl rand -base64 32   （≥32 字节，Base64 编码）
#   AES_GCM_KEY : openssl rand -base64 32   （恰好 32 字节，Base64 编码）
#   MYSQL_ROOT_PASSWORD / DB_PASSWORD / RABBITMQ_PASSWORD：openssl rand -hex 16

# ---------- 必填（缺失时 compose 直接报错） ----------
MYSQL_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
JWT_SECRET=change-me
AES_GCM_KEY=change-me
# 浏览器跨域来源（生产用实际 HTTPS 域名，本机全栈试跑用 http://localhost:8080）
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ---------- 可选（不设时使用默认值） ----------
# DB_NAME=susumonitor
# DB_USER=susumonitor
# RABBITMQ_USER=susumonitor
# RABBITMQ_VHOST=susumonitor
# OUTBOX_ENABLED=true
# ALERT_NOTIFICATION_ENABLED=false
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# ALERT_MAIL_FROM=noreply@susumonitor.local
# AGENT_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# WEB_PORT=8080
# 多实例化阶段一（2026-08-17）：Redis ticket 共享（默认 false 关闭；多实例部署时 true）
# REDIS_ENABLED=false
# REDIS_PASSWORD=（开启 REDIS_ENABLED=true 时必填；redis 容器与 server 共用，勿提交真实值）
# REDIS_TICKET_TTL_SECONDS=30

# ---------- 仅 agent profile（docker compose --profile agent） ----------
# SUSUMONITOR_BACKEND_URL=ws://server:18080
# SUSUMONITOR_SERVER_ID=change-me
# SUSUMONITOR_AGENT_TOKEN=change-me
