# 生产环境变量模板。安装为 /etc/susumonitor/server.env 后必须由 root:root 持有且权限为 0600。
# 不要将实际数据库密码、JWT 密钥、AES-GCM 密钥或 Agent 注册密钥提交到仓库。

APP_ENV=prod
APP_NAME=susumonitor
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=susumonitor
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_TIMEZONE=Asia/Shanghai

JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
JWT_EXPIRE_HOURS=72
AES_GCM_KEY=REPLACE_WITH_BASE64_AES_256_GCM_KEY
AGENT_REGISTER_KEY=REPLACE_WITH_RANDOM_AGENT_REGISTER_KEY

# 仅信任本机 Nginx 写入的转发请求头。
AGENT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# 使用实际 HTTPS 域名，不要包含路径或通配符。
CORS_ALLOWED_ORIGINS=https://SERVER_IP_OR_DOMAIN

METRICS_RETENTION_DAYS=10

# ---- AI 功能（2026-09 起）。默认全关；启用前确认服务商与 Key，密钥不入库不入日志。 ----
# 实例级总开关：关闭时所有 AI Controller 不装配（请求 404）。
AI_ENABLED=false
# OpenAI 兼容 endpoint（通常含 /v1 前缀）；默认强制 HTTPS，内网明文网关需显式放宽。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_INSECURE_HTTP=false
# 分功能开关：只读诊断随 AI_ENABLED 生效；问答/告警解释/命令域另有独立开关。
AI_QA_ENABLED=false
AI_EXPLANATION_ENABLED=false
AI_COMMAND_ENABLED=false
# F3 定时健康报告：每日生成 AI 健康报告（需 AI_ENABLED=true）。
AI_REPORT_ENABLED=false
# F3 命令自动审批的事后通知：自动批准/拒绝后是否向管理员推送通知。
AI_COMMAND_AUTO_APPROVAL_NOTIFY_ENABLED=true
# 治理参数（可选，默认值见 application.yml）：按管理员限流与按天 token 预算。
# AI_RATE_LIMIT_MAX_REQUESTS=10
# AI_RATE_LIMIT_WINDOW_SECONDS=3600
# AI_DAILY_TOKEN_BUDGET=0

# 未列出的配置项使用 application.yml 内置默认值（完整清单见 src/main/resources/application.yml）。
