# 文档进度对齐说明（2026-07-25 修订，仅文档层）
# 本节由本次"文档与实际开发进度对齐"修订追加；未修改下方原模板正文、未删除任何段落、未改动任何代码或配置。
# 修订时间：2026-07-25。
# JWT 有效期口径：以下 JWT_EXPIRE_HOURS 与代码 application.yml:36 与 JwtKeyConfig 的 72 小时一致。
# DB_CHARSET 为文档示例变量，JDBC URL 固定使用 UTF-8，主代码未消费 DB_CHARSET（占位项）。
# AGENT_REGISTER_KEY 当前 Agent WebSocket 鉴权不消费此变量，仅保留供未来注册流程（占位项）。

APP_ENV=local
APP_NAME=susumonitor
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=susumonitor
DB_USER=susumonitor
DB_PASSWORD=<YOUR_LOCAL_MYSQL_ROOT_PASSWORD>
DB_CHARSET=utf8mb4
DB_TIMEZONE=Asia/Shanghai

JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_EXPIRE_HOURS=72

AES_GCM_KEY=CHANGE_ME_LOCAL_AES_GCM_KEY
AGENT_REGISTER_KEY=CHANGE_ME_LOCAL_AGENT_REGISTER_KEY

SSH_CONNECT_TIMEOUT_SECONDS=10
SSH_IDLE_TIMEOUT_MINUTES=20

METRICS_RETENTION_DAYS=10
METRICS_CLEANUP_CRON=0 0 3 * * ?

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 未列出的配置项使用 application.yml 内置默认值（完整清单约 105 个环境变量，见 src/main/resources/application.yml 与 docs-SuMon/本机开发环境配置.md）。
